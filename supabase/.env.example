# Supabase supplies SUPABASE_URL and SUPABASE_ANON_KEY inside Edge Functions.
# Enter these privately in Edge Functions > Secrets, never commit a filled file.
BILLING_DATABASE_URL=YOUR_TEST_PROJECT_TRANSACTION_POOLER_CONNECTION_STRING
BILLING_ALLOWED_ORIGINS=https://YOUR_EXACT_VERCEL_PREVIEW_HOST
BILLING_WRITES_ENABLED=false
BILLING_SIGNUP_CODE=SET_A_PRIVATE_INVITE_CODE_IN_SUPABASE_SECRETS
# Optional: SHA-256 hex digest of the dedicated random Cron bearer token.
# Leave unset until daily reminders are tested on the paired phone.
BILLING_CRON_TOKEN_SHA256=
